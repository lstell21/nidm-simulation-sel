<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.uu.socnetid</groupId>
	<artifactId>nidm-simulation</artifactId>
	<version>4.0.1</version>
	<url>http://maven.apache.org</url>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Java version -->
		<java.version>1.8</java.version>
		<!-- JUnit version -->
		<junit.version>4.13.1</junit.version>
		<!-- log4j version -->
		<log4j.version>2.23.1</log4j.version>
		<!-- GraphStream version -->
		<gs.version>1.3</gs.version>
		<!-- Git commit ID Maven plugin version -->
		<git-commit-id-plugin.version>3.0.0</git-commit-id-plugin.version>
		<!-- Maven plugin versions -->
		<maven-clean-plugin.version>3.1.0</maven-clean-plugin.version>
		<maven-compiler-plugin.version>3.7.0</maven-compiler-plugin.version>
		<maven-shade-plugin.version>3.1.1</maven-shade-plugin.version>
		<maven-resources-plugin.version>3.0.2</maven-resources-plugin.version>
		<maven-model.version>3.6.1</maven-model.version>
		<commons-math3.version>3.6.1</commons-math3.version>
		<commons-io.version>2.8.0</commons-io.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>${maven-clean-plugin.version}</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>${basedir}/executables/</directory>
							<includes>
								<include>**/*.jar</include>
							</includes>
							<excludes>
								<exclude>**/*.log</exclude>
							</excludes>
							<followSymlinks>false</followSymlinks>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<plugin>
				<groupId>pl.project13.maven</groupId>
				<artifactId>git-commit-id-plugin</artifactId>
				<version>${git-commit-id-plugin.version}</version>
				<executions>
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>validate</phase>
					</execution>
				</executions>
				<configuration>
					<dotGitDirectory>${project.basedir}/.git</dotGitDirectory>
					<generateGitPropertiesFile>true</generateGitPropertiesFile>
					<generateGitPropertiesFilename>
						${project.build.outputDirectory}/git.properties
					</generateGitPropertiesFilename>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven-compiler-plugin.version}</version>
				<configuration>
					<!-- Java version -->
					<source>${java.version}</source>
					<target>${java.version}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>${maven-shade-plugin.version}</version>
				<executions>
					<!-- :::: Currently no need for executable GataGenerator :::: <execution>
						<id>nidm-data-generator</id> <phase>package</phase> <goals> <goal>shade</goal>
						</goals> <configuration> <transformers> <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
						<mainClass>nl.uu.socnetid.nidm.mains.DataGenerator</mainClass> </transformer>
						</transformers> <finalName>nidm-data-generator-${project.version}</finalName>
						<filters> <filter> <artifact>*:*</artifact> <excludes> <exclude>META-INF/*.SF</exclude>
						<exclude>META-INF/*.DSA</exclude> <exclude>META-INF/*.RSA</exclude> </excludes>
						</filter> </filters> </configuration> </execution> -->
					<execution>
						<id>nidm-user-interface</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>nl.uu.socnetid.nidm.mains.UserInterface</mainClass>
								</transformer>
							</transformers>
							<finalName>nidm-${git.build.version}</finalName>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
					<!-- Batch jar (target/nidm-<version>-batch.jar): only what a batch run
						(batch/run-batch.sh -> Generator) loads, so a machine with a Java 8
						runtime and a clone of this repository can run batches without Maven or
						the gephi-toolkit install. Whitelist, whole libraries only, from a
						-verbose:class trace of batch runs: our code, log4j, commons-math 2.1,
						commons-math3, GraphStream gs-core and gs-algo, and from gephi-toolkit
						only the one interface the bytecode verifier loads for NetworkStats
						(Gephi itself runs only on the GEXF path-length route, which batch runs
						never take). GUI and GEXF routes need the Maven build. Licence texts and
						sources: THIRD_PARTY_LICENSES.md, copied into the jar with licenses/.
						outputFile writes the jar directly, leaving the jar above and the main
						artifact untouched. -->
					<execution>
						<id>nidm-batch</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<outputFile>${project.build.directory}/nidm-${project.version}-batch.jar</outputFile>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<artifactSet>
								<includes>
									<include>${project.groupId}:${project.artifactId}</include>
									<include>org.apache.logging.log4j:log4j-api</include>
									<include>org.apache.logging.log4j:log4j-core</include>
									<include>org.apache.commons:commons-math</include>
									<include>org.apache.commons:commons-math3</include>
									<include>org.graphstream:gs-core</include>
									<include>org.graphstream:gs-algo</include>
									<include>org.gephi:gephi-toolkit</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
								<!-- our code plus the small config files; the data files are read
									from src/main/resources (see run-batch.sh) -->
								<filter>
									<artifact>${project.groupId}:${project.artifactId}</artifact>
									<includes>
										<include>nl/**</include>
										<include>git.properties</include>
										<include>config.properties</include>
										<include>log4j2.properties</include>
									</includes>
								</filter>
								<filter>
									<artifact>org.gephi:gephi-toolkit</artifact>
									<includes>
										<include>org/gephi/io/processor/spi/Processor.class</include>
									</includes>
								</filter>
							</filters>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>nl.uu.socnetid.nidm.mains.Generator</mainClass>
								</transformer>
								<!-- the dependencies' META-INF/NOTICE* merged into one META-INF/NOTICE;
									their META-INF/LICENSE* collide, so they are dropped here and
									added back verbatim from licenses/third-party/ below -->
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
									<addHeader>false</addHeader>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/LICENSE</resource>
									<file>${basedir}/LICENSE</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/THIRD_PARTY_LICENSES.md</resource>
									<file>${basedir}/THIRD_PARTY_LICENSES.md</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/Apache-2.0.txt</resource>
									<file>${basedir}/licenses/Apache-2.0.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/LGPL-3.0.txt</resource>
									<file>${basedir}/licenses/LGPL-3.0.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/CeCILL-C-V1-en.txt</resource>
									<file>${basedir}/licenses/CeCILL-C-V1-en.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/CDDL-1.0.txt</resource>
									<file>${basedir}/licenses/CDDL-1.0.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/log4j-api-2.23.1-LICENSE.txt</resource>
									<file>${basedir}/licenses/third-party/log4j-api-2.23.1-LICENSE.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/log4j-api-2.23.1-NOTICE.txt</resource>
									<file>${basedir}/licenses/third-party/log4j-api-2.23.1-NOTICE.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/log4j-core-2.23.1-LICENSE.txt</resource>
									<file>${basedir}/licenses/third-party/log4j-core-2.23.1-LICENSE.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/log4j-core-2.23.1-NOTICE.txt</resource>
									<file>${basedir}/licenses/third-party/log4j-core-2.23.1-NOTICE.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/commons-math-2.1-LICENSE.txt</resource>
									<file>${basedir}/licenses/third-party/commons-math-2.1-LICENSE.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/commons-math-2.1-NOTICE.txt</resource>
									<file>${basedir}/licenses/third-party/commons-math-2.1-NOTICE.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/commons-math3-3.6.1-LICENSE.txt</resource>
									<file>${basedir}/licenses/third-party/commons-math3-3.6.1-LICENSE.txt</file>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
									<resource>META-INF/licenses/third-party/commons-math3-3.6.1-NOTICE.txt</resource>
									<file>${basedir}/licenses/third-party/commons-math3-3.6.1-NOTICE.txt</file>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>${maven-resources-plugin.version}</version>
				<executions>
					<execution>
						<id>copy-files-on-build</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/executables/</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/target</directory>
									<include>nidm-${git.build.version}.jar</include>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- dependency search at https://mvnrepository.com -->
	<dependencies>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
			<version>${log4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>${log4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.graphstream</groupId>
			<artifactId>gs-core</artifactId>
			<version>${gs.version}</version>
		</dependency>
		<dependency>
			<groupId>org.graphstream</groupId>
			<artifactId>gs-algo</artifactId>
			<version>${gs.version}</version>
		</dependency>
		<dependency>
			<groupId>org.graphstream</groupId>
			<artifactId>gs-ui</artifactId>
			<version>${gs.version}</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.maven</groupId>
			<artifactId>maven-model</artifactId>
			<version>${maven-model.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-math3</artifactId>
			<version>${commons-math3.version}</version>
		</dependency>
		<dependency>
		    <groupId>commons-io</groupId>
		    <artifactId>commons-io</artifactId>
		    <version>${commons-io.version}</version>
		</dependency>
		<!--
		    Installed locally after downloading from:
		    "https://oss.sonatype.org/service/local/artifact/maven/content?r=snapshots&g=org.gephi&a=gephi-toolkit&v=0.9.3-SNAPSHOT&c=all"
		    using mvn shell command:

            mvn install:install-file \
			   -Dfile=<path-to-resources>/gephi-toolkit-0.9.3.jar \
			   -DgroupId=org.gephi \
			   -DartifactId=gephi-toolkit \
			   -Dversion=0.9.3 \
			   -Dpackaging=jar \
			   -DgeneratePom=true
		 -->
		<dependency>
		    <groupId>org.gephi</groupId>
		    <artifactId>gephi-toolkit</artifactId>
		    <version>0.9.3</version>
		</dependency>
	</dependencies>

</project>
